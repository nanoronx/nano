        </style>
      </head>
      <body>
        ${kopHtml}
        ${bodyContent}
        ${signatureHtml}
      </body>
      </html>
    `;

    const blob = new Blob(['\ufeff', fullHtml], { type: 'application/msword' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${customTitle.replace(/\s+/g, '_')}.doc`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);

    setDownloadedDocs(prev => ({ ...prev, [docType]: true }));
    showToast(`File Word "${customTitle}.doc" berhasil diunduh!`);
  };

  // Export CSV untuk e-Rapor
  const exportERaporCsv = () => {
    const headers = ['No', 'NIS', 'Nama Siswa', 'Kelas', 'Mata Pelajaran', 'TP 1', 'TP 2', 'TP 3', 'TP 4', 'STS', 'SAS', 'Nilai Akhir Rapor', 'Deskripsi Capaian Kompetensi'];
    const rows = studentsWithSummary.map((s, idx) => [
      idx + 1,
      s.nis,
      `"${s.name}"`,
      classData.activeClass,
      classData.subject,
      s.tp1,
      s.tp2,
      s.tp3,
      s.tp4,
      s.sts,
      s.sas,
      s.finalScore,
      `"${s.desc}"`
    ]);
    const csvContent = [headers.join(','), ...rows.map(r => r.join(','))].join('\n');
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Rekap_Nilai_eRapor_${classData.subject}_${classData.activeClass}.csv`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('File Rekap Nilai CSV untuk e-Rapor berhasil diunduh!');
  };

  // 18 Kartu Modul Beranda (Persis Video 0:00 - 0:07)
  const videoGridCards = [
    { id: 'c1', title: 'Data Kelas Saya', target: 'datakelas', highlight: false },
    { id: 'c2', title: 'CP dan TP', target: 'cptp', highlight: false },
    { id: 'c3', title: 'ATP', target: 'persiapan', highlight: false },
    { id: 'c4', title: 'Prota', target: 'persiapan', highlight: false },
    { id: 'c5', title: 'Promes', target: 'persiapan', highlight: true },
    { id: 'c6', title: 'Silabus', target: 'persiapan', highlight: true },
    { id: 'c7', title: 'Modul Ajar / RPP', target: 'perangkat', sub: 'modul', highlight: true },
    { id: 'c8', title: 'LKPD', target: 'perangkat', sub: 'lkpd', highlight: false },
    { id: 'c9', title: 'Soal Harian dan Kuis', target: 'perangkat', sub: 'kuis', highlight: true },
    { id: 'c10', title: 'Asesmen Sumatif', target: 'asesmen', sub: 'Asesmen Sumatif', highlight: true },
    { id: 'c11', title: 'Soal STS dan SAS', target: 'asesmen', sub: 'Soal STS dan SAS', highlight: true },
    { id: 'c12', title: 'Daftar Nilai', target: 'harian', sub: 'nilai', highlight: true },
    { id: 'c13', title: 'Presensi', target: 'harian', sub: 'presensi', highlight: false },
    { id: 'c14', title: 'Jurnal mengajar', target: 'harian', sub: 'jurnal', highlight: true },
    { id: 'c15', title: 'Deskripsi Rapor', target: 'rapor', highlight: true },
    { id: 'c16', title: 'Rekap Nilai Rapor', target: 'rapor', highlight: true },
    { id: 'c17', title: 'Paket Siap Supervisi', target: 'supervisi', highlight: true },
    { id: 'c18', title: 'Template Administrasi Kelas', target: 'template', highlight: false },
  ];

  const handleCardClick = (card) => {
    setActiveMenu(card.target);
    if (card.target === 'perangkat' && card.sub) setPerangkatType(card.sub);
    if (card.target === 'asesmen' && card.sub) setExamType(card.sub);
    if (card.target === 'harian' && card.sub) setDailyTab(card.sub);
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-[#FFF9F5] via-[#FFF3E6] to-[#FDE68A]/35 text-slate-800 flex flex-col md:flex-row font-sans">
      {/* Toast Notification */}
      {toastMsg && (
        <div className="fixed bottom-5 right-5 z-50 bg-gradient-to-r from-red-950 via-red-800 to-amber-700 text-amber-50 px-5 py-3.5 rounded-2xl shadow-2xl flex items-center gap-3 border border-amber-300/60">
          <div className="w-7 h-7 rounded-full bg-gradient-to-br from-yellow-300 to-amber-500 flex items-center justify-center text-red-950 shrink-0 shadow-xs">
            <CheckCircle2 className="w-4 h-4" />
          </div>
          <span className="text-xs sm:text-sm font-bold tracking-wide">{toastMsg}</span>
        </div>
      )}

      {/* Modal Tambah Rombel Paralel (Mendukung Kelas VII A-F, VIII A-F, IX A-F) */}
      {showRombelModal && (
        <div className="fixed inset-0 z-50 bg-red-950/60 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-2xl w-full p-6 md:p-7 shadow-2xl border-2 border-red-300/80 max-h-[90vh] overflow-y-auto">
            <div className="flex items-center justify-between mb-3">
              <div>
                <span className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-gradient-to-r from-red-100 to-amber-100 text-red-900 text-[11px] font-extrabold mb-1 border border-red-200">
                  <Sparkles className="w-3 h-3 text-red-600" /> Multi-Rombel Otomatis
                </span>
                <h3 className="text-lg font-extrabold text-slate-900">Tambah Rombel Paralel (Kelas VII, VIII & IX)</h3>
                <p className="text-xs text-slate-500">
                  Pilih kelas paralel yang Anda ajar (VII A–F, VIII A–F, IX A–F). Data CP, TP, Modul Ajar & Soal otomatis menyesuaikan jenjang.
                </p>
              </div>
