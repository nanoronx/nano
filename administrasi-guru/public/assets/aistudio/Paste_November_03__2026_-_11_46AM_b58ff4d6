                    { id: 'prota', label: 'Program Tahunan (Prota)' },
                    { id: 'promes', label: 'Program Semester (Promes)' },
                    { id: 'silabus', label: 'Silabus' },
                  ].map((doc) => (
                    <div
                      key={doc.id}
                      className="p-4 rounded-2xl border border-red-200 bg-gradient-to-br from-red-50/60 via-amber-50/40 to-white flex flex-col justify-between gap-3 shadow-2xs"
