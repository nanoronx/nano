                    {tps.map(tp => {
                      const isSelected = selectedTp.id === tp.id;
                      return (
                        <button
                          key={tp.id}
                          onClick={() => setSelectedTpId(tp.id)}
                          className={`p-3.5 rounded-2xl border-2 text-left transition flex items-center justify-between ${
                            isSelected
                              ? 'border-red-500 bg-red-50/60 shadow-xs'
                              : 'border-red-200/70 hover:border-red-400 bg-white'
                          }`}
                        >
                          <div className="flex items-center gap-3">
                            <span className="px-2.5 py-1 rounded-lg bg-gradient-to-r from-red-700 to-amber-500 text-white font-extrabold text-xs">{tp.code}</span>
                            <span className="font-bold text-slate-900 text-sm">{tp.title}</span>
                          </div>
                          {isSelected && <CheckCircle2 className="w-4 h-4 text-red-600 shrink-0" />}
                        </button>
                      );
                    })}
                  </div>
                </div>
              </div>

              {/* Pratinjau Dokumen Kertas A4 */}
              <div className="bg-white rounded-3xl p-6 md:p-8 border-2 border-red-200/80 shadow-sm">
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-6 border-b border-red-100">
                  <div>
                    <span className="text-xs font-extrabold uppercase text-red-700">Pratinjau Dokumen Siap Cetak (Format Sekolah)</span>
                    <h3 className="text-lg font-extrabold text-slate-900">
                      {perangkatType === 'modul' ? 'Modul Ajar / RPP' : perangkatType === 'lkpd' ? 'Lembar Kerja Peserta Didik (LKPD)' : 'Soal Harian dan Kuis Formatif'} — TP {selectedTp.code} ({selectedTp.title})
                    </h3>
                  </div>
                  <button
                    onClick={() =>
                      generateWordDocument(
                        perangkatType === 'modul' ? 'modul' : perangkatType === 'lkpd' ? 'lkpd' : 'asesmen',
                        `${perangkatType.toUpperCase()} TP ${selectedTp.code} ${selectedTp.title} ${classData.activeClass}`
                      )
                    }
                    className="px-4 py-2.5 rounded-xl bg-gradient-to-r from-red-700 via-red-600 to-amber-500 hover:from-red-800 hover:to-amber-600 text-white font-extrabold text-xs flex items-center gap-2 self-start shrink-0 shadow-sm"
                  >
                    <Download className="w-4 h-4" /> Unduh File Word (.doc)
                  </button>
                </div>

                {/* Simulasi Lembar A4 dengan Kop Sekolah */}
                <div className="border border-red-300 rounded-2xl p-6 md:p-8 bg-white text-slate-900 space-y-4 shadow-inner">
                  {classData.useSchoolHeader && (
                    <div className="text-center border-b-4 border-double border-slate-900 pb-3 mb-4">
                      <div className="text-xs font-bold uppercase">{classData.pemda}</div>
                      <div className="text-xs font-bold uppercase">{classData.dinas}</div>
                      <div className="text-lg font-extrabold uppercase">{classData.schoolName}</div>
                      <div className="text-[11px] text-slate-600">{classData.address}</div>
                    </div>
                  )}

                  <div className="grid grid-cols-2 text-xs gap-y-1 bg-gradient-to-r from-red-50/60 to-amber-50/60 p-3.5 rounded-xl border border-red-200">
                    <div><b>Satuan Pendidikan:</b> {classData.schoolName}</div>
                    <div><b>Kelas / Fase:</b> {classData.activeClass} / {classData.fase}</div>
                    <div><b>Mata Pelajaran:</b> {classData.subject}</div>
                    <div><b>Alokasi Waktu:</b> {selectedTp.jp} JP (Minggu ke-{selectedTp.weeks.join(', ')})</div>
                  </div>

                  {perangkatType === 'modul' && (
                    <div className="space-y-3 text-sm">
                      <div>
                        <h4 className="font-bold text-slate-900">A. Tujuan Pembelajaran (TP {selectedTp.code})</h4>
                        <p className="text-slate-700">{selectedTp.indikator}</p>
                      </div>
                      <div>
                        <h4 className="font-bold text-slate-900">B. Langkah-Langkah Kegiatan Pembelajaran</h4>
                        <ul className="list-disc pl-5 space-y-1 text-slate-700">
                          <li><b>Pendahuluan (10 Menit):</b> Salam, doa, presensi siswa kelas {classData.activeClass}, dan apersepsi mengaitkan materi <b>{selectedTp.title}</b> dengan kehidupan nyata.</li>
                          <li><b>Kegiatan Inti (60 Menit):</b> {selectedTp.aktivitas}</li>
                          <li><b>Penutup (10 Menit):</b> Refleksi bersama peserta didik, kesimpulan materi {selectedTp.materi}, dan kuis evaluasi singkat.</li>
                        </ul>
                      </div>
                      <div>
                        <h4 className="font-bold text-slate-900">C. Asesmen Pembelajaran</h4>
                        <p className="text-slate-700">Asesmen Formatif (Observasi diskusi & LKPD) serta Asesmen Sumatif Lingkup Materi.</p>
                      </div>
                    </div>
