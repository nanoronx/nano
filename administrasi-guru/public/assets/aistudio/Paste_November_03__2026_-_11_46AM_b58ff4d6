                Tutup ✕
              </button>
            </div>

            {/* Filter Tab Jenjang Kelas */}
            <div className="flex flex-wrap items-center gap-2 my-4 pb-3 border-b border-red-100">
              {[
                { id: 'ALL', label: 'Semua Jenjang (VII, VIII, IX)' },
                { id: 'VII', label: 'Kelas VII (A–F)' },
                { id: 'VIII', label: 'Kelas VIII (A–F)' },
                { id: 'IX', label: 'Kelas IX (A–F)' },
