      `;
    } else if (docType === 'lkpd') {
      bodyContent = `
        <h3 style="text-align:center; font-size:12pt; margin: 0 0 12px 0;">LEMBAR KERJA PESERTA DIDIK (LKPD)</h3>
        ${identityTableHtml}
        <div style="border:1px solid #000; padding:10px; margin-bottom:12px; font-size:10pt;">
          <b>Nama Kelompok / Siswa :</b> ....................................................................<br/>
          <b>Kelas / Rombel :</b> ${classData.activeClass}<br/>
          <b>Topik Bahasan :</b> TP ${selectedTp.code} - ${selectedTp.title}
        </div>
        <p style="font-size:10pt;"><b>A. Tujuan Aktivitas:</b><br/>${selectedTp.indikator}</p>
        <p style="font-size:10pt;"><b>B. Instruksi Kerja Kelompok:</b><br/>${selectedTp.aktivitas}</p>
        <p style="font-size:10pt;"><b>C. Pertanyaan Diskusi & Latihan:</b></p>
        <ol style="font-size:10pt; line-height:1.6;">
          ${selectedTp.questions.map(q => `<li>${q.q}<br/>a. ${q.options[0]} &nbsp;&nbsp; b. ${q.options[1]} &nbsp;&nbsp; c. ${q.options[2]} &nbsp;&nbsp; d. ${q.options[3]}</li>`).join('')}
          <li><b>Soal Eksplorasi Kelompok:</b> ${selectedTp.essay}<br/><br/><i>Jawaban Kelompok:</i><br/>......................................................................................................................................................<br/>......................................................................................................................................................</li>
        </ol>
      `;
    } else if (docType === 'asesmen') {
      bodyContent = `
        <h3 style="text-align:center; font-size:12pt; margin: 0 0 12px 0;">DOKUMEN ${examType.toUpperCase()} (KISI-KISI, SOAL & KUNCI JAWABAN)</h3>
        ${identityTableHtml}
        <h4 style="font-size:10pt; margin:10px 0 6px 0;">1. KISI-KISI PENULISAN SOAL</h4>
        <table style="width:100%; border-collapse:collapse; font-size:9.5pt;" border="1" cellpadding="5">
          <thead>
            <tr style="background-color:#f0f0f0; font-weight:bold; text-align:center;">
              <th>No</th>
              <th>Kode TP</th>
              <th>Materi Pokok</th>
              <th>Indikator Soal</th>
              <th>Level</th>
              <th>Bentuk Soal</th>
            </tr>
          </thead>
          <tbody>
            ${tps.map((tp, idx) => `
              <tr>
                <td style="text-align:center;">${idx + 1}</td>
                <td style="text-align:center; font-weight:bold;">${tp.code}</td>
                <td>${tp.materi}</td>
                <td>${tp.indikator}</td>
                <td style="text-align:center;">L2 / C3</td>
                <td style="text-align:center;">PG & Uraian</td>
              </tr>
            `).join('')}
          </tbody>
        </table>
        <h4 style="font-size:10pt; margin:16px 0 6px 0;">2. NASKAH SOAL & KUNCI JAWABAN</h4>
        <ol style="font-size:10pt; line-height:1.5;">
          ${tps.flatMap(tp => tp.questions.map(q => `
            <li style="margin-bottom:8px;">
              [TP ${tp.code}] ${q.q}<br/>
              A. ${q.options[0]} &nbsp;&nbsp; B. ${q.options[1]} &nbsp;&nbsp; C. ${q.options[2]} &nbsp;&nbsp; D. ${q.options[3]}<br/>
              <b>Kunci Jawaban: ${q.ans}</b> (Level Kognitif: ${q.level})
            </li>
          `)).join('')}
        </ol>
      `;
    } else if (docType === 'nilai' || docType === 'rapor') {
      bodyContent = `
        <h3 style="text-align:center; font-size:12pt; margin: 0 0 12px 0;">DAFTAR NILAI & REKAP CAPAIAN RAPOR PESERTA DIDIK</h3>
        ${identityTableHtml}
        <table style="width:100%; border-collapse:collapse; font-size:9.5pt;" border="1" cellpadding="5">
          <thead>
            <tr style="background-color:#f0f0f0; font-weight:bold; text-align:center;">
              <th style="width:5%;">No</th>
              <th style="width:20%;">Nama Peserta Didik</th>
              <th style="width:7%;">TP 1</th>
              <th style="width:7%;">TP 2</th>
              <th style="width:7%;">TP 3</th>
              <th style="width:7%;">TP 4</th>
              <th style="width:7%;">STS</th>
              <th style="width:7%;">SAS</th>
              <th style="width:8%;">Nilai Rapor</th>
              <th style="width:25%;">Deskripsi Capaian Kompetensi Rapor</th>
