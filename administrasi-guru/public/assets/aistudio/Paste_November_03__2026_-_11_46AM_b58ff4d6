              <div>
                <h1 className="font-extrabold text-white text-base leading-tight tracking-tight">Administrasi Guru</h1>
                <p className="text-xs font-semibold text-amber-200">Sekali isi, 1 semester beres</p>
              </div>
            </div>
          </div>

          {/* Active Class & Rombel Quick Switcher */}
          <div className="p-4 mx-3.5 mt-4 rounded-2xl bg-gradient-to-br from-red-50 via-amber-50/80 to-yellow-100/60 border border-red-300/70 shadow-2xs">
            <div className="flex items-center justify-between mb-1">
              <span className="text-xs font-extrabold text-red-900 uppercase tracking-wider">{classData.subject}</span>
              <span className="text-[11px] font-extrabold bg-gradient-to-r from-red-700 to-amber-500 text-white px-2.5 py-0.5 rounded-full shadow-2xs">
