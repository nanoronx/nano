                      </div>

                      <div className="grid grid-cols-3 sm:grid-cols-6 gap-2.5">
                        {groupList.map(rombel => {
                          const isSelected = classData.parallelClasses.includes(rombel);
                          const isCurrentActive = classData.activeClass === rombel;
                          return (
                            <button
                              key={rombel}
                              onClick={() => toggleParallelRombel(rombel)}
                              className={`py-2.5 px-3 rounded-xl font-extrabold text-sm border-2 transition-all flex flex-col items-center justify-center ${
                                isSelected
                                  ? 'bg-gradient-to-br from-red-700 via-red-600 to-amber-500 text-white border-amber-400 shadow-sm scale-[1.02]'
                                  : 'bg-white text-slate-700 border-red-200/80 hover:border-red-400 hover:bg-red-50/40'
                              }`}
                            >
                              <span>{rombel}</span>
                              {isCurrentActive && (
                                <span className="text-[9px] bg-amber-100 text-red-900 px-1.5 rounded-full font-extrabold mt-0.5 shadow-2xs">
                                  Aktif
                                </span>
                              )}
                            </button>
                          );
                        })}
                      </div>
                    </div>
                  );
                })}
            </div>

            {/* Tambah Rombel Kustom (Misal: VII G, VIII H, IX Unggulan) */}
            <div className="p-3.5 rounded-2xl bg-red-50/60 border border-red-200 mb-5 flex flex-col sm:flex-row items-center gap-2">
              <input
                type="text"
                placeholder="Punya rombel lain? Ketik misal: VII G, VIII H, atau IX G..."
                value={customRombelInput}
                onChange={(e) => setCustomRombelInput(e.target.value)}
                className="flex-1 w-full px-3.5 py-2.5 rounded-xl border border-red-300 text-xs font-semibold bg-white focus:outline-none focus:border-red-600"
              />
              <button
                onClick={handleAddCustomRombel}
                className="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-gradient-to-r from-red-900 to-amber-900 text-amber-100 font-bold text-xs shrink-0 hover:from-red-800 hover:to-amber-800 transition"
              >
                + Tambah Rombel Kustom
              </button>
            </div>

            <div className="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-red-100">
              <div className="text-xs text-slate-600">
                Total dipilih: <b className="text-red-700">{classData.parallelClasses.length} Rombel</b> ({classData.parallelClasses.join(', ')})
              </div>
              <button
                onClick={() => {
                  setShowRombelModal(false);
                  showToast(`${classData.parallelClasses.length} Rombel paralel aktif & siap digunakan!`);
                }}
                className="w-full sm:w-auto px-6 py-3 rounded-xl bg-gradient-to-r from-red-700 via-red-600 to-amber-500 hover:from-red-800 hover:to-amber-600 text-white font-extrabold text-sm shadow-md shadow-red-600/20 transition"
              >
                Simpan ({classData.parallelClasses.length} Rombel Aktif)
              </button>
            </div>
          </div>
        </div>
      )}

