            ${studentsWithSummary.map((s, idx) => `
              <tr>
                <td style="text-align:center;">${idx + 1}</td>
                <td style="font-weight:bold;">${s.name}</td>
                <td style="text-align:center;">${s.tp1}</td>
                <td style="text-align:center;">${s.tp2}</td>
                <td style="text-align:center;">${s.tp3}</td>
                <td style="text-align:center;">${s.tp4}</td>
                <td style="text-align:center;">${s.sts}</td>
                <td style="text-align:center;">${s.sas}</td>
                <td style="text-align:center; font-weight:bold;">${s.finalScore}</td>
                <td style="font-size:8.5pt;">${s.desc}</td>
              </tr>
