                  <table className="w-full text-left border-collapse text-sm">
                    <thead>
                      <tr className="border-b border-red-200 text-red-900 text-xs uppercase bg-gradient-to-r from-red-50 to-amber-50">
                        <th className="p-3 font-extrabold">Kode</th>
                        <th className="p-3 font-extrabold">Tujuan Pembelajaran</th>
                        <th className="p-3 font-extrabold">Materi Pokok</th>
                        <th className="p-3 font-extrabold">Indikator Ketercapaian (IKTP)</th>
                        <th className="p-3 font-extrabold text-center">Alokasi</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-red-100">
                      {tps.map(tp => (
                        <tr key={tp.id} className="hover:bg-red-50/40">
                          <td className="p-3 font-extrabold text-red-700">{tp.code}</td>
                          <td className="p-3 font-bold text-slate-900">{tp.title}</td>
                          <td className="p-3 text-slate-600">{tp.materi}</td>
                          <td className="p-3 text-slate-600">{tp.indikator}</td>
                          <td className="p-3 text-center font-extrabold text-red-900">{tp.jp} JP</td>
                        </tr>
                      ))}
                    </tbody>
