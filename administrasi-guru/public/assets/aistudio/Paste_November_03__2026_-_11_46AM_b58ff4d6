                  {perangkatType === 'lkpd' && (
                    <div className="space-y-4 text-sm">
                      <div className="p-3 border border-dashed border-red-400 rounded-xl text-xs space-y-1 bg-red-50/30">
                        <div><b>Nama Kelompok / Siswa:</b> ..................................................................</div>
                        <div><b>Kelas:</b> {classData.activeClass} &nbsp;&nbsp;|&nbsp;&nbsp; <b>Materi:</b> {selectedTp.title}</div>
                      </div>
                      <div>
                        <h4 className="font-bold">Petunjuk Aktivitas Kelompok:</h4>
                        <p className="text-slate-700">{selectedTp.aktivitas}</p>
                      </div>
                      <div>
                        <h4 className="font-bold">Tugas Diskusi:</h4>
                        <p className="text-slate-800 font-medium mt-1">1. {selectedTp.essay}</p>
                        <div className="mt-2 h-20 border border-red-200 rounded-xl bg-red-50/20 p-2 text-xs text-slate-400">
                          Area jawaban tertulis peserta didik...
                        </div>
                      </div>
                    </div>
                  )}

                  {perangkatType === 'kuis' && (
                    <div className="space-y-4 text-sm">
                      <h4 className="font-bold">Soal Kuis Harian — TP {selectedTp.code} ({selectedTp.title})</h4>
                      <div className="space-y-3">
                        {selectedTp.questions.map((q, i) => (
                          <div key={i} className="p-3.5 rounded-xl bg-red-50/40 border border-red-200">
                            <div className="font-semibold text-slate-900">{i + 1}. {q.q}</div>
                            <div className="grid grid-cols-2 gap-1 mt-1.5 text-xs text-slate-700">
                              <div>A. {q.options[0]}</div>
                              <div>B. {q.options[1]}</div>
                              <div>C. {q.options[2]}</div>
                              <div>D. {q.options[3]}</div>
                            </div>
                            <div className="mt-2 text-xs font-bold text-emerald-700">
                              Kunci Jawaban: {q.ans} • Level Kognitif: {q.level}
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          )}

          {/* ==========================================
              VIEW 5: MODE HARIAN DI KELAS / HP MODE (VIDEO 0:30 - 0:36)
          ========================================== */}
          {activeMenu === 'harian' && (
            <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
              {/* Frame HP Interaktif (Persis Video 0:30 - 0:35) */}
              <div className="lg:col-span-5 flex justify-center">
                <div className="w-full max-w-[380px] bg-white rounded-[36px] border-[6px] border-red-950 shadow-2xl p-5 space-y-5">
                  <div className="w-16 h-1.5 bg-red-200 rounded-full mx-auto" />
                  <div>
                    <div className="text-xs font-semibold text-slate-500">
                      {journalDate} • <span className="font-extrabold text-red-700">{classData.activeClass}</span>
                    </div>
                    <h3 className="text-xl font-extrabold text-slate-900 mt-0.5">
                      {dailyTab === 'presensi' ? 'Presensi' : dailyTab === 'jurnal' ? 'Jurnal mengajar' : 'Daftar Nilai'}
                    </h3>
                  </div>

                  {/* Tab Switcher: Presensi | Jurnal | Nilai */}
                  <div className="grid grid-cols-3 gap-2">
                    {[
                      { id: 'presensi', label: 'Presensi' },
                      { id: 'jurnal', label: 'Jurnal' },
                      { id: 'nilai', label: 'Nilai' },
                    ].map(t => (
                      <button
                        key={t.id}
                        onClick={() => setDailyTab(t.id)}
                        className={`py-2 px-3 rounded-xl font-extrabold text-xs transition ${
                          dailyTab === t.id
                            ? 'bg-gradient-to-r from-red-700 to-amber-500 text-white shadow-xs'
                            : 'bg-red-50 text-red-900 border border-red-200'
                        }`}
                      >
                        {t.label}
                      </button>
                    ))}
                  </div>

                  {/* TAB 1: PRESENSI */}
                  {dailyTab === 'presensi' && (
                    <div className="space-y-2.5">
                      {students.map(s => (
                        <div
                          key={s.id}
                          className="p-3 rounded-xl border border-red-200/80 bg-red-50/30 flex items-center justify-between"
                        >
                          <span className="font-bold text-slate-900 text-sm">{s.name.split(' ')[0]}</span>
                          <div className="flex items-center gap-1">
                            {['H', 'S', 'I', 'A'].map(status => {
                              const active = s.attendance === status;
                              const label = status === 'H' ? 'Hadir' : status;
                              return (
                                <button
                                  key={status}
                                  onClick={() =>
                                    setStudents(prev => prev.map(st => st.id === s.id ? { ...st, attendance: status } : st))
                                  }
                                  className={`px-2.5 py-1 rounded-lg text-xs font-bold transition ${
                                    active
                                      ? status === 'H'
                                        ? 'bg-emerald-100 text-emerald-800 border border-emerald-300'
                                        : 'bg-gradient-to-r from-red-600 to-amber-500 text-white'
                                      : 'bg-white text-slate-500 border border-slate-200'
                                  }`}
                                >
                                  {label}
                                </button>
                              );
                            })}
                          </div>
                        </div>
                      ))}
                      <button
                        onClick={() => showToast(`Presensi kelas ${classData.activeClass} berhasil disimpan!`)}
                        className="w-full mt-2 py-2.5 rounded-xl bg-gradient-to-r from-red-700 via-red-600 to-amber-500 text-white font-extrabold text-xs shadow-sm"
                      >
                        Simpan Presensi Hari Ini
                      </button>
                    </div>
                  )}

                  {/* TAB 2: JURNAL MENGAJAR */}
                  {dailyTab === 'jurnal' && (
                    <div className="space-y-3">
                      <div className="p-3.5 rounded-xl border border-red-200 bg-red-50/40 space-y-3">
                        <div>
                          <label className="block text-[11px] font-bold text-slate-600">Tanggal Pertemuan</label>
                          <input
                            type="text"
                            value={journalDate}
                            onChange={(e) => setJournalDate(e.target.value)}
                            className="w-full mt-1 px-2.5 py-1.5 rounded-lg border border-red-300 text-xs font-semibold bg-white"
                          />
                        </div>
                        <div>
                          <label className="block text-[11px] font-bold text-slate-600">Materi (Sesuai TP)</label>
