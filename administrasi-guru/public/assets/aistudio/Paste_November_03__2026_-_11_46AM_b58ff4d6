                <div className="grid grid-cols-3 gap-3 md:gap-4">
                  {[
                    { id: 'modul', title: 'Modul Ajar / RPP' },
                    { id: 'lkpd', title: 'LKPD' },
                    { id: 'kuis', title: 'Soal Harian dan Kuis' },
                  ].map(card => {
                    const active = perangkatType === card.id;
                    return (
                      <button
                        key={card.id}
                        onClick={() => setPerangkatType(card.id)}
                        className={`p-4 rounded-2xl border-2 text-center transition-all flex flex-col items-center justify-center gap-2 ${
                          active
                            ? 'border-red-500 bg-gradient-to-br from-red-50 via-amber-50 to-yellow-100/60 shadow-sm'
                            : 'border-red-200/80 bg-white hover:border-red-400'
                        }`}
                      >
                        <FileText className={`w-7 h-7 ${active ? 'text-red-600' : 'text-slate-400'}`} />
                        <div className="font-extrabold text-slate-900 text-xs sm:text-sm">{card.title}</div>
                        <span className="text-emerald-600 font-bold text-xs flex items-center gap-0.5">
                          <Check className="w-3.5 h-3.5" /> Siap
                        </span>
                      </button>
                    );
                  })}
