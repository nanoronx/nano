                        </div>
                        <div className="flex items-center gap-2 shrink-0">
                          <span className="hidden sm:inline-block px-2.5 py-1 rounded-md bg-emerald-50 border border-emerald-200 text-emerald-700 font-bold text-xs">
                            Sudah ada
                          </span>
                          <button
                            onClick={() => generateWordDocument(item.id, item.label.replace('.doc', ''))}
                            className="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-red-700 to-amber-500 hover:from-red-800 hover:to-amber-600 text-white font-extrabold text-xs flex items-center gap-1 shadow-2xs"
                          >
                            <Download className="w-3.5 h-3.5" /> Unduh
                          </button>
                        </div>
                      </div>
                    );
                  })}
                </div>

                <button
                  onClick={() => {
                    generateWordDocument('paket_lengkap', `Paket Lengkap Supervisi Administrasi Guru ${classData.subject} ${classData.activeClass} ${classData.academicYear}`);
                    setDownloadedDocs({ atp: true, prota: true, promes: true, silabus: true, modul: true, asesmen: true, nilai: true, rapor: true });
                  }}
                  className="w-full py-4 rounded-2xl bg-gradient-to-r from-red-700 via-red-600 to-amber-500 hover:from-red-800 hover:to-amber-600 text-white font-extrabold text-base shadow-lg shadow-red-600/25 flex items-center justify-center gap-2 transition"
                >
                  <CheckCircle2 className="w-5 h-5" /> Unduh Paket Lengkap Supervisi (.doc)
                </button>
              </div>
            </div>
          )}

        </div>
      </main>
    </div>
  );
}