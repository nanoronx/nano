// Helper untuk mendeteksi tingkat kelas (7, 8, atau 9) dari nama Rombel
const getGradePrefixFromRombel = (rombelName = '') => {
  const upper = rombelName.toUpperCase().trim();
  if (upper.startsWith('IX') || upper.startsWith('9')) return '9';
  if (upper.startsWith('VIII') || upper.startsWith('8')) return '8';
  return '7';
};

// Helper menyesuaikan kode TP (7.1 / 8.1 / 9.1) dengan tingkat rombel aktif
const adaptTpCodesToRombel = (tpList, rombelName) => {
  const prefix = getGradePrefixFromRombel(rombelName);
  return tpList.map((tp, idx) => {
    const subNum = tp.code.includes('.') ? tp.code.split('.')[1] : idx + 1;
    return {
      ...tp,
      code: `${prefix}.${subNum}`
    };
  });
};

