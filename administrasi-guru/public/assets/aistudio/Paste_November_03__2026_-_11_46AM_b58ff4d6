                              <button
                                key={w}
                                onClick={() => togglePromesWeek(tp.id, w)}
                                title={`TP ${tp.code} - Minggu ke-${w}`}
                                className={`h-9 rounded-lg border transition-all ${
                                  active
                                    ? 'bg-gradient-to-br from-red-700 to-amber-500 border-red-700 shadow-xs'
                                    : 'bg-red-50/40 border-red-200/70 hover:bg-amber-100/60'
                                }`}
                              />
                            );
                          })}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              {/* Tabel Ringkasan ATP, Prota & Silabus */}
