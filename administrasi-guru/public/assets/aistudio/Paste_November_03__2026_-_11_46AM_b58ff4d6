                            value={journalMateri}
                            onChange={(e) => setJournalMateri(e.target.value)}
                            className="w-full mt-1 px-2.5 py-1.5 rounded-lg border border-red-300 text-xs font-bold bg-white"
                          >
                            {tps.map(tp => (
                              <option key={tp.id} value={tp.title}>TP {tp.code} - {tp.title}</option>
                            ))}
                          </select>
