                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
                  <div>
                    <h3 className="text-xl font-extrabold text-slate-900">Program Semester (Promes)</h3>
                    <p className="text-sm text-slate-500">
                      {classData.semester === 'Ganjil' ? 'Juli–Desember' : 'Januari–Juni'} • 16 minggu efektif (Klik kotak minggu untuk mengatur jadwal JP)
                    </p>
                  </div>
                  <button
                    onClick={() => generateWordDocument('promes', `Program Semester ${classData.subject} ${classData.activeClass} ${classData.academicYear}`)}
                    className="px-4 py-2.5 rounded-xl bg-gradient-to-r from-red-700 via-red-600 to-amber-500 text-white font-extrabold text-xs flex items-center gap-1.5 self-start shadow-sm"
