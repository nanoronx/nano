        <h3 style="text-align:center; font-size:12pt; margin: 0 0 12px 0;">PAKET LENGKAP ADMINISTRASI GURU SATU SEMESTER</h3>
        ${identityTableHtml}
        <p style="font-size:10pt;"><b>1. Capaian Pembelajaran (CP):</b><br/>${cpText}</p>
        <p style="font-size:10pt;"><b>2. Ringkasan Alur Tujuan Pembelajaran (ATP) & Prota:</b></p>
        <table style="width:100%; border-collapse:collapse; font-size:9.5pt; margin-bottom:14px;" border="1" cellpadding="5">
          <tr style="background-color:#f0f0f0; font-weight:bold;">
            <th>Kode TP</th><th>Tujuan Pembelajaran</th><th>Materi Pokok</th><th>Alokasi JP</th><th>Minggu Efektif</th>
